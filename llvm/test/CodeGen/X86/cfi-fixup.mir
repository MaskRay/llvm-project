# RUN: llc -o - %s -mtriple=x86_64-- -run-pass=cfi-fixup | FileCheck %s
# RUN: llc -o - %s -mtriple=x86_64-- -passes=cfi-fixup | FileCheck %s
--- |
  define void @epilogue_in_middle() "frame-pointer"="all" { ret void }
  define void @partial_epilogue() "frame-pointer"="all" { ret void }
