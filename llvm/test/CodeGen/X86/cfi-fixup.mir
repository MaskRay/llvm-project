---
# bb.3 follows a block that ends with an epilogue but needs the frame.
name:            epilogue_in_middle
fixedStack:
  - { id: 0, type: spill-slot, offset: -32, size: 8, alignment: 8, callee-saved-register: '$r14' }
  - { id: 1, type: spill-slot, offset: -24, size: 8, alignment: 8, callee-saved-register: '$r12' }
  - { id: 2, type: spill-slot, offset: -16, size: 8, alignment: 16 }
body:             |
  ; CHECK-LABEL: name: epilogue_in_middle
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $r12, $r14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   frame-setup PUSH64r killed $rbp, implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_offset 16
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $rbp, -16
  ; CHECK-NEXT:   $rbp = frame-setup MOV64rr $rsp
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_register $rbp
  ; CHECK-NEXT:   frame-setup PUSH64r killed $r12, implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-setup PUSH64r killed $r14, implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $r12, -24
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $r14, -32
  ; CHECK-NEXT:   CFI_INSTRUCTION remember_state
  ; CHECK-NEXT:   TEST8rr renamable $dil, renamable $dil, implicit-def $eflags, implicit killed $edi
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit killed $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r12 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $r14 = IMPLICIT_DEF
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   dead $eax = MOV32r0 implicit-def dead $eflags, implicit-def $rax
  ; CHECK-NEXT:   $r14 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   $r12 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION def_cfa $rsp, 8
  ; CHECK-NEXT:   RET 0, killed $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   CFI_INSTRUCTION restore_state
  ; CHECK-NEXT:   dead $eax = MOV32r0 implicit-def dead $eflags, implicit-def $rax
  ; CHECK-NEXT:   $r14 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   $r12 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION def_cfa $rsp, 8
  ; CHECK-NEXT:   RET 0, killed $rax
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $edi, $r12, $r14

    frame-setup PUSH64r killed $rbp, implicit-def $rsp, implicit $rsp
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    frame-setup CFI_INSTRUCTION offset $rbp, -16
    $rbp = frame-setup MOV64rr $rsp
    frame-setup CFI_INSTRUCTION def_cfa_register $rbp
    frame-setup PUSH64r killed $r12, implicit-def $rsp, implicit $rsp
    frame-setup PUSH64r killed $r14, implicit-def $rsp, implicit $rsp
    frame-setup CFI_INSTRUCTION offset $r12, -24
    frame-setup CFI_INSTRUCTION offset $r14, -32
    TEST8rr renamable $dil, renamable $dil, implicit-def $eflags, implicit killed $edi
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3

    renamable $r12 = IMPLICIT_DEF
    renamable $r14 = IMPLICIT_DEF
    JMP_1 %bb.3

  bb.2:
    dead $eax = MOV32r0 implicit-def dead $eflags, implicit-def $rax
    $r14 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    $r12 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    frame-destroy CFI_INSTRUCTION def_cfa $rsp, 8
    RET 0, killed $rax

  bb.3:
    dead $eax = MOV32r0 implicit-def dead $eflags, implicit-def $rax
    $r14 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    $r12 = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    frame-destroy CFI_INSTRUCTION def_cfa $rsp, 8
    RET 0, killed $rax

...
---
# bb.2's epilogue does not restore the rules of rbp and rbx, which bb.3, on a
# path that bypasses the prologue, must not inherit.
name:            partial_epilogue
fixedStack:
  - { id: 0, type: spill-slot, offset: -24, size: 8, alignment: 8, callee-saved-register: '$rbx' }
  - { id: 1, type: spill-slot, offset: -16, size: 8, alignment: 16 }
body:             |
  ; CHECK-LABEL: name: partial_epilogue
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $rbx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST8rr renamable $dil, renamable $dil, implicit-def $eflags, implicit killed $edi
  ; CHECK-NEXT:   JCC_1 %bb.2, 5, implicit killed $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $rbx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   frame-setup PUSH64r killed $rbp, implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_offset 16
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $rbp, -16
  ; CHECK-NEXT:   $rbp = frame-setup MOV64rr $rsp
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_register $rbp
  ; CHECK-NEXT:   frame-setup PUSH64r killed $rbx, implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $rbx, -24
  ; CHECK-NEXT:   $rbx = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION def_cfa $rsp, 8
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   CFI_INSTRUCTION def_cfa $rsp, 8
  ; CHECK-NEXT:   CFI_INSTRUCTION restore $rbp
  ; CHECK-NEXT:   CFI_INSTRUCTION restore $rbx
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $edi, $rbx

    TEST8rr renamable $dil, renamable $dil, implicit-def $eflags, implicit killed $edi
    JCC_1 %bb.2, 5, implicit killed $eflags

  bb.1:
    successors: %bb.3

    JMP_1 %bb.3

  bb.2:
    liveins: $rbx

    frame-setup PUSH64r killed $rbp, implicit-def $rsp, implicit $rsp
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    frame-setup CFI_INSTRUCTION offset $rbp, -16
    $rbp = frame-setup MOV64rr $rsp
    frame-setup CFI_INSTRUCTION def_cfa_register $rbp
    frame-setup PUSH64r killed $rbx, implicit-def $rsp, implicit $rsp
    frame-setup CFI_INSTRUCTION offset $rbx, -24
    $rbx = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    frame-destroy CFI_INSTRUCTION def_cfa $rsp, 8
    RET 0

  bb.3:
    RET 0

...
