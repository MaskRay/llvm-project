# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=i686-linux-gnu -run-pass=cfi-fixup %s -o - | FileCheck %s
## CFIFixup tracks the CFA offset change of call frame adjustments across
## blocks.

--- |
  define void @restore_state() uwtable { ret void }
  define void @noreturn() uwtable { ret void }
  declare void @g()
  declare void @abort1()
...
---
## bb.2 is entered with an argument pushed, after the epilogue of bb.1.
name: restore_state
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: restore_state
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $esp = frame-setup SUB32ri $esp, 12, implicit-def dead $eflags
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_offset 16
  ; CHECK-NEXT:   CFI_INSTRUCTION remember_state
  ; CHECK-NEXT:   PUSH32i 1, implicit-def $esp, implicit $esp
  ; CHECK-NEXT:   CFI_INSTRUCTION adjust_cfa_offset 4
  ; CHECK-NEXT:   TEST32rr $eax, $eax, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   CALLpcrel32 @g, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp
  ; CHECK-NEXT:   $esp = ADD32ri $esp, 4, implicit-def dead $eflags
  ; CHECK-NEXT:   CFI_INSTRUCTION adjust_cfa_offset -4
  ; CHECK-NEXT:   $esp = frame-destroy ADD32ri $esp, 12, implicit-def dead $eflags
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION def_cfa_offset 4
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   CFI_INSTRUCTION restore_state
  ; CHECK-NEXT:   CFI_INSTRUCTION adjust_cfa_offset 4
  ; CHECK-NEXT:   CALLpcrel32 @abort1, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $eax
    $esp = frame-setup SUB32ri $esp, 12, implicit-def dead $eflags
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    PUSH32i 1, implicit-def $esp, implicit $esp
    CFI_INSTRUCTION adjust_cfa_offset 4
    TEST32rr $eax, $eax, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags

  bb.1:
    CALLpcrel32 @g, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp
    $esp = ADD32ri $esp, 4, implicit-def dead $eflags
    CFI_INSTRUCTION adjust_cfa_offset -4
    $esp = frame-destroy ADD32ri $esp, 12, implicit-def dead $eflags
    frame-destroy CFI_INSTRUCTION def_cfa_offset 4
    RET 0

  bb.2:
    CALLpcrel32 @abort1, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp
...
---
## bb.1 ends with a noreturn call that leaves its argument pushed.
name: noreturn
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: noreturn
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $esp = frame-setup SUB32ri $esp, 12, implicit-def dead $eflags
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_offset 16
  ; CHECK-NEXT:   TEST32rr $eax, $eax, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors:
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PUSH32i 1, implicit-def $esp, implicit $esp
  ; CHECK-NEXT:   CFI_INSTRUCTION adjust_cfa_offset 4
  ; CHECK-NEXT:   CALLpcrel32 @abort1, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   CFI_INSTRUCTION adjust_cfa_offset -4
  ; CHECK-NEXT:   $esp = frame-destroy ADD32ri $esp, 12, implicit-def dead $eflags
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION def_cfa_offset 4
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $eax
    $esp = frame-setup SUB32ri $esp, 12, implicit-def dead $eflags
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    TEST32rr $eax, $eax, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags

  bb.1:
    successors:
    PUSH32i 1, implicit-def $esp, implicit $esp
    CFI_INSTRUCTION adjust_cfa_offset 4
    CALLpcrel32 @abort1, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp

  bb.2:
    $esp = frame-destroy ADD32ri $esp, 12, implicit-def dead $eflags
    frame-destroy CFI_INSTRUCTION def_cfa_offset 4
    RET 0
...
