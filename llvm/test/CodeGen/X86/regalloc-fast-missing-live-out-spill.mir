# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64-grtev4-linux-gnu -run-pass=regallocfast -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-grtev4-linux-gnu -passes=regallocfast -o - %s | FileCheck %s

# Bug 41973. Make sure %12 is detected as live out of %bb.0, even
# though the use is allocated before the def block %bb.3. Previously
# mayLiveOut only recorded on defs, and would not find the virtual
# register use if it had already been replaced with a physical
# register.

---
name:            main
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: main
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $edi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $rsi = COPY killed $rsi
  ; CHECK-NEXT:   renamable $edi = COPY killed $edi
  ; CHECK-NEXT:   dead renamable $edi = COPY killed renamable $edi
  ; CHECK-NEXT:   renamable $rsi = COPY killed renamable $rsi
  ; CHECK-NEXT:   renamable $rsi = COPY killed renamable $rsi
  ; CHECK-NEXT:   MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rsi :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors:
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $rax = MOV64rm %stack.1, 1, $noreg, 0, $noreg :: (load (s64) from %stack.1)
  ; CHECK-NEXT:   renamable $rcx = COPY renamable $rax
  ; CHECK-NEXT:   renamable $edx = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   renamable $rdx = SUBREG_TO_REG killed renamable $edx, %subreg.sub_32bit
  ; CHECK-NEXT:   MOV64mi32 killed renamable $rcx, 1, $noreg, 0, $noreg, 0 :: (volatile store (s64))
  ; CHECK-NEXT:   MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdx :: (store (s64) into %stack.0)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
  ; CHECK-NEXT:   renamable $ecx = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   renamable $rcx = SUBREG_TO_REG killed renamable $ecx, %subreg.sub_32bit
  ; CHECK-NEXT:   MOV64mr %stack.1, 1, $noreg, 0, $noreg, killed $rcx :: (store (s64) into %stack.1)
  ; CHECK-NEXT:   JMP64r killed renamable $rax
  bb.0:
    liveins: $edi, $rsi

    %4:gr64 = COPY $rsi
    %2:gr32 = COPY $edi
    %3:gr32 = COPY killed %2
    %5:gr64 = COPY killed %4
    %13:gr64 = COPY %5
    JMP_1 %bb.3

  bb.1:
    successors:

  bb.2:
    %0:gr64 = COPY %12
    %10:gr32 = MOV32r0 implicit-def $eflags
    %11:gr64 = SUBREG_TO_REG %10, %subreg.sub_32bit
    MOV64mi32 %0, 1, $noreg, 0, $noreg, 0 :: (volatile store (s64))
    %13:gr64 = COPY %11

  bb.3:
    successors: %bb.2, %bb.1

    %1:gr64 = COPY %13
    %9:gr32 = MOV32r0 implicit-def dead $eflags
    %8:gr64 = SUBREG_TO_REG killed %9, %subreg.sub_32bit
    %12:gr64 = COPY %8
    JMP64r %1

...
